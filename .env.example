# Скопируй в .env и заполни реальными значениями. .env не коммитится (см. .gitignore).

# Токен бота, полученный от @BotFather в Telegram.
TELEGRAM_BOT_TOKEN=

# ID чата/пользователя, куда бот будет слать алерты.
# Быстрый способ узнать свой chat id: написать боту любое сообщение,
# затем открыть https://api.telegram.org/bot<TELEGRAM_BOT_TOKEN>/getUpdates
# и найти chat.id в ответе.
TELEGRAM_CHAT_ID=

# Опционально: путь к бинарнику Chromium, если путь по умолчанию в
# browser.mjs/browser-stealth.mjs не подходит для этой машины (см. Plan.md, шаг 2).
CHROMIUM_PATH=
